# Void Market — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Server ───────────────────────────────────────────────
# Port for the Colyseus game server
PORT=2567

# ─── Database ─────────────────────────────────────────────
# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voidmarket

# ─── Redis ────────────────────────────────────────────────
# Redis connection string (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# ─── Client ───────────────────────────────────────────────
# Vite dev server port (default 5173, set via vite.config)
# VITE_SERVER_URL=http://localhost:2567
